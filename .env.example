# ---- LLM provider (leave keys empty to run without an LLM: static analysis + demo mode) ----
# gemini | groq | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Model names are configured here only (defaults live in backend/core/config.py).
# Provider model catalogues change: text-embedding-004 and Groq's llama-3.3-70b-versatile were both retired in 2026.
# If you get 404 / model_not_found errors, check the provider's current model list and update these three values.
# (gemini-flash-latest is a Google alias that follows the current Flash model.)
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=gemini-embedding-2
LLM_TIMEOUT_SECONDS=60

# ---- Application ----
DATABASE_URL=sqlite:///./data/codepilot.db
CHROMA_DIR=./data/chroma
API_URL=http://localhost:8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
MAX_CODE_BYTES=200000
MAX_UPLOAD_BYTES=200000
MAX_REPAIR_ATTEMPTS=3

# ---- Sandbox (Docker) ----
SANDBOX_IMAGE=codepilot-sandbox:latest
EXEC_TIMEOUT_SECONDS=30
EXEC_MEMORY=256m
EXEC_CPUS=1.0
EXEC_PIDS_LIMIT=64
EXEC_MAX_OUTPUT_BYTES=100000
